<?xml version="1.0" encoding="UTF-8"?>
<!--
  fishbot（四轮长方体底盘）+ Franka Panda 七自由度机械臂（MuJoCo 版）
  对应 ROS 2 URDF：fishbot.urdf.xacro + panda.urdf.xacro
  单位：米 / 千克 / 秒 / 弧度
  底盘：0.70 × 0.50 × 0.22 m，8 kg，四轮差速（轮距 0.48，轴距 0.40，轮 r=0.05）
  机械臂：Franka Panda 7-DOF，mesh 使用开源 collision STL，惯量取自官方 URDF
-->
<mujoco model="fishbot_panda">
  <compiler angle="radian" autolimits="true" coordinate="local" eulerseq="xyz"/>
  <option gravity="0 0 -9.81" integrator="Euler" timestep="0.002" iterations="50">
    <flag contact="enable" frictionloss="enable"/>
  </option>

  <default>
    <geom rgba="0.78 0.80 0.86 1" contype="1" conaffinity="1" friction="1.0 0.005 0.0001"/>
    <joint damping="0.1" armature="0.005" limited="true"/>
    <motor ctrllimited="true"/>
    <position kp="40" ctrllimited="true"/>
  </default>

  <asset>
    <texture name="ground_tex" type="2d" builtin="checker" width="300" height="300"
             rgb1="0.45 0.48 0.52" rgb2="0.38 0.41 0.45"/>
    <material name="ground_mat" texture="ground_tex" texrepeat="8 8" reflectance="0.05"/>
    <!-- Panda 碰撞网格（来自开源 panda_description） -->
    <mesh name="panda_link0" file="meshes/link0.stl"/>
    <mesh name="panda_link1" file="meshes/link1.stl"/>
    <mesh name="panda_link2" file="meshes/link2.stl"/>
    <mesh name="panda_link3" file="meshes/link3.stl"/>
    <mesh name="panda_link4" file="meshes/link4.stl"/>
    <mesh name="panda_link5" file="meshes/link5.stl"/>
    <mesh name="panda_link6" file="meshes/link6.stl"/>
    <mesh name="panda_link7" file="meshes/link7.stl"/>
    <mesh name="panda_hand" file="meshes/hand.stl"/>
  </asset>

  <worldbody>
    <light name="light0" pos="0 0 4" dir="0 0 -1" diffuse="0.8 0.8 0.8" specular="0.3 0.3 0.3"/>
    <light name="light1" pos="-3 -3 3" dir="1 1 -1" diffuse="0.4 0.4 0.4"/>
    <geom name="ground" type="plane" size="6 6 0.1" material="ground_mat" friction="1.0 0.1 0.01"/>

    <!-- ================= 四轮长方体底盘 ================= -->
    <body name="base" pos="0 0 0.11">
      <freejoint/>
      <geom name="base_geom" type="box" size="0.35 0.25 0.11" pos="0 0 0" rgba="0.92 0.93 0.95 1" friction="1.2 0.01 0.0001"/>
      <inertial pos="0 0 0" mass="8.0" diaginertia="0.1989 0.3589 0.4933"/>

      <!-- 四轮：前左/前右/后左/后右 -->
      <body name="left_front_wheel" pos="0.20 0.24 -0.06">
        <joint name="left_front_wheel_joint" type="hinge" axis="0 1 0" limited="false"/>
        <geom name="left_front_wheel_geom" type="cylinder" size="0.05 0.02" euler="1.5708 0 0"
              rgba="0.95 0.80 0.15 1" friction="3.0 0.005 0.0001"/>
        <inertial pos="0 0 0" mass="0.3" diaginertia="0.0002 0.0002 0.0004"/>
      </body>
      <body name="left_back_wheel" pos="-0.20 0.24 -0.06">
        <joint name="left_back_wheel_joint" type="hinge" axis="0 1 0" limited="false"/>
        <geom name="left_back_wheel_geom" type="cylinder" size="0.05 0.02" euler="1.5708 0 0"
              rgba="0.95 0.80 0.15 1" friction="3.0 0.005 0.0001"/>
        <inertial pos="0 0 0" mass="0.3" diaginertia="0.0002 0.0002 0.0004"/>
      </body>
      <body name="right_front_wheel" pos="0.20 -0.24 -0.06">
        <joint name="right_front_wheel_joint" type="hinge" axis="0 1 0" limited="false"/>
        <geom name="right_front_wheel_geom" type="cylinder" size="0.05 0.02" euler="1.5708 0 0"
              rgba="0.95 0.80 0.15 1" friction="3.0 0.005 0.0001"/>
        <inertial pos="0 0 0" mass="0.3" diaginertia="0.0002 0.0002 0.0004"/>
      </body>
      <body name="right_back_wheel" pos="-0.20 -0.24 -0.06">
        <joint name="right_back_wheel_joint" type="hinge" axis="0 1 0" limited="false"/>
        <geom name="right_back_wheel_geom" type="cylinder" size="0.05 0.02" euler="1.5708 0 0"
              rgba="0.95 0.80 0.15 1" friction="3.0 0.005 0.0001"/>
        <inertial pos="0 0 0" mass="0.3" diaginertia="0.0002 0.0002 0.0004"/>
      </body>

      <!-- 传感器支架 -->
      <body name="laser" pos="-0.30 0 0.20">
        <geom name="laser_geom" type="cylinder" size="0.02 0.01" rgba="0.1 0.1 0.1 1"/>
      </body>
      <body name="camera_mount" pos="0.28 0 0.05">
        <geom name="camera_geom" type="box" size="0.01 0.05 0.01" rgba="0.1 0.1 0.1 1"/>
        <camera name="camera_front" pos="0.03 0 0.01" xyaxes="1 0 0  0 0 1" fovy="60"/>
      </body>
      <camera name="camera_follow" pos="-2.2 1.5 1.4" xyaxes="0.8 -0.6 0  0.3 0.4 0.87" fovy="55"/>

      <!-- ================= Franka Panda 七自由度机械臂 =================
           安装在底盘顶面中央（base 中心上方 0.11 = 顶面）
           URDF 关节轴统一为 (0,0,1)，通过 body euler 实现坐标系旋转（与 URDF origin rpy 对应） -->
      <body name="panda_link0" pos="0 0 0.11">
        <geom name="panda_link0_geom" mesh="panda_link0" rgba="0.55 0.55 0.58 1"/>
        <inertial pos="-0.041018 -0.00014 0.049974" mass="0.629769"
                  diaginertia="0.00315 0.00388 0.004285"/>

        <body name="panda_link1" pos="0 0 0.333">
          <joint name="panda_joint1" type="hinge" axis="0 0 1" range="-2.9671 2.9671" damping="1.0"/>
          <geom name="panda_link1_geom" mesh="panda_link1" rgba="0.9 0.9 0.92 1"/>
          <inertial pos="0.003875 0.002081 -0.04762" mass="4.970684"
                    diaginertia="0.70337 0.70661 0.009117"/>

          <body name="panda_link2" pos="0 0 0" euler="-1.5708 0 0">
            <joint name="panda_joint2" type="hinge" axis="0 0 1" range="-1.8326 1.8326" damping="1.0"/>
            <geom name="panda_link2_geom" mesh="panda_link2" rgba="0.55 0.55 0.58 1"/>
            <inertial pos="-0.003141 -0.02872 0.003495" mass="0.646926"
                      diaginertia="0.007962 0.02811 0.025995"/>

            <body name="panda_link3" pos="0 -0.316 0" euler="1.5708 0 0">
              <joint name="panda_joint3" type="hinge" axis="0 0 1" range="-2.9671 2.9671" damping="1.0"/>
              <geom name="panda_link3_geom" mesh="panda_link3" rgba="0.9 0.9 0.92 1"/>
              <inertial pos="0.027518 0.039252 -0.066502" mass="3.228604"
                        diaginertia="0.037242 0.036155 0.01083"/>

              <body name="panda_link4" pos="0.0825 0 0" euler="1.5708 0 0">
                <joint name="panda_joint4" type="hinge" axis="0 0 1" range="-3.1416 0.0873" damping="1.0"/>
                <geom name="panda_link4_geom" mesh="panda_link4" rgba="0.55 0.55 0.58 1"/>
                <inertial pos="-0.05317 0.104419 0.027454" mass="3.587895"
                          diaginertia="0.025853 0.019552 0.028323"/>

                <body name="panda_link5" pos="-0.0825 0.384 0" euler="-1.5708 0 0">
                  <joint name="panda_joint5" type="hinge" axis="0 0 1" range="-2.9671 2.9671" damping="1.0"/>
                  <geom name="panda_link5_geom" mesh="panda_link5" rgba="0.9 0.9 0.92 1"/>
                  <inertial pos="-0.011953 0.041065 -0.038437" mass="1.225946"
                            diaginertia="0.035549 0.029474 0.008627"/>

                  <body name="panda_link6" pos="0 0 0" euler="1.5708 0 0">
                    <joint name="panda_joint6" type="hinge" axis="0 0 1" range="-0.0873 3.8223" damping="1.0"/>
                    <geom name="panda_link6_geom" mesh="panda_link6" rgba="0.55 0.55 0.58 1"/>
                    <inertial pos="0.060149 -0.014117 -0.010517" mass="1.666555"
                              diaginertia="0.001964 0.004354 0.005433"/>

                    <body name="panda_link7" pos="0.088 0 0" euler="1.5708 0 0">
                      <joint name="panda_joint7" type="hinge" axis="0 0 1" range="-2.9671 2.9671" damping="1.0"/>
                      <geom name="panda_link7_geom" mesh="panda_link7" rgba="0.9 0.9 0.92 1"/>
                      <inertial pos="0.010517 -0.004252 0.061597" mass="0.735522"
                                diaginertia="0.012516 0.010027 0.004815"/>

                      <body name="panda_link8" pos="0 0 0.107">
                        <body name="panda_hand" euler="0 0 -0.7854">
                          <geom name="panda_hand_geom" mesh="panda_hand" rgba="0.9 0.9 0.92 1"/>
                          <inertial pos="-0.01 0 0.03" mass="0.73"
                                    diaginertia="0.001 0.0025 0.0017"/>
                          <!-- 末端参考点 -->
                          <site name="end_site" pos="0 0 0.09" size="0.01" rgba="0.2 0.9 0.3 1"/>
                        </body>
                      </body>
                    </body>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <!-- 执行器：四轮扭矩控制 + Panda 七关节位置控制 -->
  <actuator>
    <motor name="lf_wheel_motor" joint="left_front_wheel_joint" ctrlrange="-5 5"/>
    <motor name="lb_wheel_motor" joint="left_back_wheel_joint" ctrlrange="-5 5"/>
    <motor name="rf_wheel_motor" joint="right_front_wheel_joint" ctrlrange="-5 5"/>
    <motor name="rb_wheel_motor" joint="right_back_wheel_joint" ctrlrange="-5 5"/>
    <position name="panda_joint1_act" joint="panda_joint1" ctrlrange="-2.9671 2.9671"/>
    <position name="panda_joint2_act" joint="panda_joint2" ctrlrange="-1.8326 1.8326"/>
    <position name="panda_joint3_act" joint="panda_joint3" ctrlrange="-2.9671 2.9671"/>
    <position name="panda_joint4_act" joint="panda_joint4" ctrlrange="-3.1416 0.0873"/>
    <position name="panda_joint5_act" joint="panda_joint5" ctrlrange="-2.9671 2.9671"/>
    <position name="panda_joint6_act" joint="panda_joint6" ctrlrange="-0.0873 3.8223"/>
    <position name="panda_joint7_act" joint="panda_joint7" ctrlrange="-2.9671 2.9671"/>
  </actuator>

  <!-- 传感器 -->
  <sensor>
    <framepos name="endeffector_pos" objtype="site" objname="end_site"/>
  </sensor>
</mujoco>
