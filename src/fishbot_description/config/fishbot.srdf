<?xml version="1.0"?>
<!--
  六自由度机械臂 MoveIt 语义描述（SRDF）
  规划组：arm_group（6 个旋转关节）
  预定义姿态：home / up / down
-->
<robot name="fishbot">

  <!-- 机械臂规划组 -->
  <group name="arm_group">
    <joint name="arm_joint1"/>
    <joint name="arm_joint2"/>
    <joint name="arm_joint3"/>
    <joint name="arm_joint4"/>
    <joint name="arm_joint5"/>
    <joint name="arm_joint6"/>
  </group>

  <!-- 预定义姿态 -->
  <group_state name="home" group="arm_group">
    <joint name="arm_joint1" value="0.0"/>
    <joint name="arm_joint2" value="0.0"/>
    <joint name="arm_joint3" value="0.0"/>
    <joint name="arm_joint4" value="0.0"/>
    <joint name="arm_joint5" value="0.0"/>
    <joint name="arm_joint6" value="0.0"/>
  </group_state>

  <group_state name="up" group="arm_group">
    <joint name="arm_joint1" value="0.0"/>
    <joint name="arm_joint2" value="-1.57"/>
    <joint name="arm_joint3" value="0.0"/>
    <joint name="arm_joint4" value="0.0"/>
    <joint name="arm_joint5" value="0.0"/>
    <joint name="arm_joint6" value="0.0"/>
  </group_state>

  <group_state name="down" group="arm_group">
    <joint name="arm_joint1" value="0.0"/>
    <joint name="arm_joint2" value="1.0"/>
    <joint name="arm_joint3" value="-1.5"/>
    <joint name="arm_joint4" value="0.0"/>
    <joint name="arm_joint5" value="0.5"/>
    <joint name="arm_joint6" value="0.0"/>
  </group_state>

</robot>
