<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:include filename="$(find fishbot_description)/urdf/fishbot/common_inertia.xacro"/>

    <!--
        6-DOF 机械臂（6R 关节臂，UR 风格）
        安装：arm_base_link 固定在 base_link 顶面（z = base 半径 = 0.08）
        关节：
          arm_joint1  基座旋转  (z 轴)
          arm_joint2  肩部俯仰  (y 轴)
          arm_joint3  肘部俯仰  (y 轴)
          arm_joint4  腕部滚转  (x 轴)
          arm_joint5  腕部俯仰  (y 轴)
          arm_joint6  末端旋转  (z 轴)
        全部使用 position 接口，由 joint_trajectory_controller 控制
    -->
    <xacro:macro name="arm_xacro">

        <!-- ============ 基座（固定） ============ -->
        <link name="arm_base_link">
            <visual>
                <origin xyz="0.0 0.0 0.0125" rpy="0.0 0.0 0.0"/>
                <geometry><cylinder radius="0.045" length="0.025"/></geometry>
                <material name="arm_dark">
                    <color rgba="0.25 0.25 0.30 1.0"/>
                </material>
            </visual>
            <collision>
                <origin xyz="0.0 0.0 0.0125" rpy="0.0 0.0 0.0"/>
                <geometry><cylinder radius="0.045" length="0.025"/></geometry>
            </collision>
            <xacro:cylinder_inertia m="0.3" r="0.045" h="0.025"/>
        </link>

        <joint name="arm_base_joint" type="fixed">
            <origin xyz="0.0 0.0 0.08" rpy="0.0 0.0 0.0"/>
            <parent link="base_link"/>
            <child link="arm_base_link"/>
        </joint>

        <!-- ============ 连杆 1（肩部立柱，绕 z 旋转） ============ -->
        <link name="arm_link1">
            <visual>
                <origin xyz="0.0 0.0 0.06" rpy="0.0 0.0 0.0"/>
                <geometry><cylinder radius="0.035" length="0.12"/></geometry>
                <material name="arm_blue">
                    <color rgba="0.20 0.45 0.80 1.0"/>
                </material>
            </visual>
            <collision>
                <origin xyz="0.0 0.0 0.06" rpy="0.0 0.0 0.0"/>
                <geometry><cylinder radius="0.035" length="0.12"/></geometry>
            </collision>
            <xacro:cylinder_inertia m="0.5" r="0.035" h="0.12"/>
        </link>

        <joint name="arm_joint1" type="revolute">
            <origin xyz="0.0 0.0 0.025" rpy="0.0 0.0 0.0"/>
            <parent link="arm_base_link"/>
            <child link="arm_link1"/>
            <axis xyz="0.0 0.0 1.0"/>
            <limit lower="-3.14159" upper="3.14159" effort="10.0" velocity="2.0"/>
        </joint>

        <!-- ============ 连杆 2（大臂，绕 y 俯仰） ============ -->
        <link name="arm_link2">
            <visual>
                <origin xyz="0.09 0.0 0.0" rpy="0.0 0.0 0.0"/>
                <geometry><box size="0.06 0.06 0.20"/></geometry>
                <material name="arm_blue">
                    <color rgba="0.20 0.45 0.80 1.0"/>
                </material>
            </visual>
            <collision>
                <origin xyz="0.09 0.0 0.0" rpy="0.0 0.0 0.0"/>
                <geometry><box size="0.06 0.06 0.20"/></geometry>
            </collision>
            <xacro:box_inertia m="0.9" w="0.06" h="0.06" d="0.20"/>
        </link>

        <joint name="arm_joint2" type="revolute">
            <origin xyz="0.0 0.0 0.12" rpy="0.0 0.0 0.0"/>
            <parent link="arm_link1"/>
            <child link="arm_link2"/>
            <axis xyz="0.0 1.0 0.0"/>
            <limit lower="-2.0" upper="2.0" effort="20.0" velocity="2.0"/>
        </joint>

        <!-- ============ 连杆 3（小臂，绕 y 俯仰） ============ -->
        <link name="arm_link3">
            <visual>
                <origin xyz="0.08 0.0 0.0" rpy="0.0 0.0 0.0"/>
                <geometry><box size="0.05 0.05 0.16"/></geometry>
                <material name="arm_light">
                    <color rgba="0.80 0.82 0.88 1.0"/>
                </material>
            </visual>
            <collision>
                <origin xyz="0.08 0.0 0.0" rpy="0.0 0.0 0.0"/>
                <geometry><box size="0.05 0.05 0.16"/></geometry>
            </collision>
            <xacro:box_inertia m="0.6" w="0.05" h="0.05" d="0.16"/>
        </link>

        <joint name="arm_joint3" type="revolute">
            <origin xyz="0.18 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <parent link="arm_link2"/>
            <child link="arm_link3"/>
            <axis xyz="0.0 1.0 0.0"/>
            <limit lower="-2.5" upper="1.5" effort="15.0" velocity="2.0"/>
        </joint>

        <!-- ============ 连杆 4（腕部滚转，绕 x 旋转） ============ -->
        <link name="arm_link4">
            <visual>
                <origin xyz="0.03 0.0 0.0" rpy="0.0 0.0 0.0"/>
                <geometry><box size="0.04 0.04 0.06"/></geometry>
                <material name="arm_dark">
                    <color rgba="0.25 0.25 0.30 1.0"/>
                </material>
            </visual>
            <collision>
                <origin xyz="0.03 0.0 0.0" rpy="0.0 0.0 0.0"/>
                <geometry><box size="0.04 0.04 0.06"/></geometry>
            </collision>
            <xacro:box_inertia m="0.3" w="0.04" h="0.04" d="0.06"/>
        </link>

        <joint name="arm_joint4" type="revolute">
            <origin xyz="0.15 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <parent link="arm_link3"/>
            <child link="arm_link4"/>
            <axis xyz="1.0 0.0 0.0"/>
            <limit lower="-3.14159" upper="3.14159" effort="8.0" velocity="2.0"/>
        </joint>

        <!-- ============ 连杆 5（腕部俯仰，绕 y 旋转） ============ -->
        <link name="arm_link5">
            <visual>
                <origin xyz="0.035 0.0 0.0" rpy="0.0 0.0 0.0"/>
                <geometry><box size="0.04 0.04 0.07"/></geometry>
                <material name="arm_blue">
                    <color rgba="0.20 0.45 0.80 1.0"/>
                </material>
            </visual>
            <collision>
                <origin xyz="0.035 0.0 0.0" rpy="0.0 0.0 0.0"/>
                <geometry><box size="0.04 0.04 0.07"/></geometry>
            </collision>
            <xacro:box_inertia m="0.25" w="0.04" h="0.04" d="0.07"/>
        </link>

        <joint name="arm_joint5" type="revolute">
            <origin xyz="0.06 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <parent link="arm_link4"/>
            <child link="arm_link5"/>
            <axis xyz="0.0 1.0 0.0"/>
            <limit lower="-2.0" upper="2.0" effort="8.0" velocity="2.0"/>
        </joint>

        <!-- ============ 连杆 6（末端 + 夹爪，绕 z 旋转） ============ -->
        <link name="arm_link6">
            <!-- 腕部本体 -->
            <visual>
                <origin xyz="0.04 0.0 0.0" rpy="0.0 0.0 0.0"/>
                <geometry><box size="0.03 0.05 0.08"/></geometry>
                <material name="arm_light">
                    <color rgba="0.80 0.82 0.88 1.0"/>
                </material>
            </visual>
            <!-- 左夹爪指 -->
            <visual>
                <origin xyz="0.085 0.014 0.0" rpy="0.0 0.0 0.0"/>
                <geometry><box size="0.03 0.012 0.035"/></geometry>
                <material name="arm_dark">
                    <color rgba="0.25 0.25 0.30 1.0"/>
                </material>
            </visual>
            <!-- 右夹爪指 -->
            <visual>
                <origin xyz="0.085 -0.014 0.0" rpy="0.0 0.0 0.0"/>
                <geometry><box size="0.03 0.012 0.035"/></geometry>
                <material name="arm_dark">
                    <color rgba="0.25 0.25 0.30 1.0"/>
                </material>
            </visual>
            <collision>
                <origin xyz="0.05 0.0 0.0" rpy="0.0 0.0 0.0"/>
                <geometry><box size="0.10 0.05 0.08"/></geometry>
            </collision>
            <xacro:box_inertia m="0.35" w="0.10" h="0.05" d="0.08"/>
        </link>

        <joint name="arm_joint6" type="revolute">
            <origin xyz="0.07 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <parent link="arm_link5"/>
            <child link="arm_link6"/>
            <axis xyz="0.0 0.0 1.0"/>
            <limit lower="-3.14159" upper="3.14159" effort="5.0" velocity="2.0"/>
        </joint>

        <!-- ============ Gazebo 属性：材质摩擦、自碰撞 ============ -->
        <gazebo reference="arm_base_link">
            <mu1 value="1.0"/><mu2 value="1.0"/>
        </gazebo>
        <gazebo reference="arm_link1">
            <mu1 value="1.0"/><mu2 value="1.0"/>
        </gazebo>
        <gazebo reference="arm_link2">
            <mu1 value="1.0"/><mu2 value="1.0"/>
        </gazebo>
        <gazebo reference="arm_link3">
            <mu1 value="1.0"/><mu2 value="1.0"/>
        </gazebo>
        <gazebo reference="arm_link4">
            <mu1 value="1.0"/><mu2 value="1.0"/>
        </gazebo>
        <gazebo reference="arm_link5">
            <mu1 value="1.0"/><mu2 value="1.0"/>
        </gazebo>
        <gazebo reference="arm_link6">
            <mu1 value="1.0"/><mu2 value="1.0"/>
        </gazebo>
    </xacro:macro>
</robot>
