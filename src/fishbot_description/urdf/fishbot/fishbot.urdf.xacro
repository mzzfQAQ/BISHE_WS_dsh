<?xml version="1.0"?>
<robot xmlns:xacro = "http://www.ros.org/wiki/xacro" name="fishbot">
<!-- 基础部分 base_link（四轮长方体底盘） -->
<xacro:include filename="$(find fishbot_description)/urdf/fishbot/base.urdf.xacro"/>
<!-- 传感器部分 -->
<xacro:include filename="$(find fishbot_description)/urdf/fishbot/sensor/imu.urdf.xacro"/>
<xacro:include filename="$(find fishbot_description)/urdf/fishbot/sensor/laser.urdf.xacro"/>
<xacro:include filename="$(find fishbot_description)/urdf/fishbot/sensor/camera.urdf.xacro"/>
<!-- 执行器部分：四轮 -->
<xacro:include filename="$(find fishbot_description)/urdf/fishbot/actuator/wheel.urdf.xacro"/>
<!-- Franka Emika Panda 七自由度机械臂（开源描述，位于 panda_description 包） -->
<xacro:include filename="$(find panda_description)/urdf/panda.urdf.xacro"/>
<!-- 插件 -->
<xacro:include filename="$(find fishbot_description)/urdf/fishbot/plugins/gazebo_sensor_plugin.xacro"/>
<xacro:include filename="$(find fishbot_description)/urdf/fishbot/fishbot.ros2_control.xacro"/>

<!-- ================= 底盘：四轮长方体 =================
     尺寸按 Panda 机械臂（总重约 18kg，臂展 0.855m）设计：
     长 0.70 × 宽 0.50 × 高 0.22 m，质量 8 kg（保证承载稳定）
     base_footprint 在地面，base_link 中心在 z=0.11 -->
<xacro:base_xacro length = "0.70" width = "0.50" height = "0.22" mass = "8.0"/>

<!-- 传感器位置（Panda 占据顶部中央，激光后移、相机前移） -->
<xacro:imu_xacro xyz="0.0 0.0 0.05"/>
<xacro:camera_xacro xyz="0.28 0.0 0.05"/>
<xacro:laser_xacro xyz="-0.12 0.0 0.16"/>

<!-- 四轮：前左/前右/后左/后右
     轮子半径 0.05，中心 y=±0.24（外露于 0.25 半宽），x=±0.20（轴距 0.40），z=-0.06（着地） -->
<xacro:wheel_xacro wheel_name = "left_front_wheel" xyz="0.20 0.24 -0.06"/>
<xacro:wheel_xacro wheel_name = "left_back_wheel"  xyz="-0.20 0.24 -0.06"/>
<xacro:wheel_xacro wheel_name = "right_front_wheel" xyz="0.20 -0.24 -0.06"/>
<xacro:wheel_xacro wheel_name = "right_back_wheel"  xyz="-0.20 -0.24 -0.06"/>

<!-- ================= Franka Panda 机械臂 =================
     安装在底盘顶面中央：base_link 顶面 z=0.11 -->
<joint name="panda_base_joint" type="fixed">
    <origin xyz="0.0 0.0 0.11" rpy="0.0 0.0 0.0"/>
    <parent link="base_link"/>
    <child link="panda_link0"/>
</joint>

<gazebo reference="base_link">
    <selfCollide>false</selfCollide>
</gazebo>

<xacro:gazebo_sensor_plugin/>
<xacro:fishbot_ros2_control/>

</robot>
